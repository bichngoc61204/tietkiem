rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Chủ hệ thống (có thể thêm email admin hoặc đặt role == 'admin' trong users/{uid})
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'hung@gmail.com' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        )
      );
    }

    function isPositiveNumber(val) {
      return (val is int || val is float) && val >= 0;
    }

    // =========================================================================
    // 1. USERS PROFILE, SAAS PLAN & PERSONAL SUBCOLLECTIONS
    // =========================================================================
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // Khi đăng ký mới: chỉ được tạo role 'user' (trừ admin), gói khởi tạo 'free' hoặc 'trial'
      allow create: if (isOwner(userId) && (
          (request.resource.data.role == 'user' && request.resource.data.plan in ['free', 'trial'])
          || request.auth.token.email == 'hung@gmail.com'
        )) || isAdmin();

      // Khi cập nhật:
      // - Admin được sửa mọi trường (cấp gói, gia hạn, khóa tài khoản).
      // - Chủ tài khoản được sửa cài đặt tài chính cá nhân, KHÔNG tự nâng cấp role/plan
      //   trừ khi kích hoạt kèm một licenseKey hợp lệ trong cùng writeBatch.
      allow update: if isAdmin() || (
        isOwner(userId) && (
          (
            request.resource.data.role == resource.data.role &&
            request.resource.data.plan == resource.data.plan &&
            request.resource.data.subscriptionStatus == resource.data.subscriptionStatus &&
            request.resource.data.planExpiresAt == resource.data.planExpiresAt
          ) || (
            request.resource.data.role == resource.data.role &&
            request.resource.data.lastLicenseCode is string &&
            exists(/databases/$(database)/documents/licenseKeys/$(request.resource.data.lastLicenseCode)) &&
            get(/databases/$(database)/documents/licenseKeys/$(request.resource.data.lastLicenseCode)).data.usedBy == null &&
            get(/databases/$(database)/documents/licenseKeys/$(request.resource.data.lastLicenseCode)).data.active == true &&
            getAfter(/databases/$(database)/documents/licenseKeys/$(request.resource.data.lastLicenseCode)).data.usedBy == request.auth.uid &&
            request.resource.data.plan == get(/databases/$(database)/documents/licenseKeys/$(request.resource.data.lastLicenseCode)).data.plan
          )
        )
      );

      allow delete: if isAdmin() || isOwner(userId);

      // Exact restore of an authorized test snapshot may contain legacy negative balances.
      // New negative writes are still denied. Both snapshot consumption and account restore
      // must be part of the same atomic operation.
      function isExactTestBackupRestore(accountId) {
        let before = get(/databases/$(database)/documents/users/$(userId)).data;
        let after = getAfter(/databases/$(database)/documents/users/$(userId)).data;
        return isOwner(userId)
          && request.auth.token.email == 'hung@gmail.com'
          && before.financeTestBackup != null
          && accountId in before.financeTestBackup.accounts
          && request.resource.data == before.financeTestBackup.accounts[accountId]
          && after.financeTestBackup == null;
      }

      // Ví tiền cá nhân (MB Bank, VCB, Tiền mặt, Tiết kiệm)
      match /accounts/{accountId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if (isOwner(userId) || isAdmin())
          && request.resource.data.name is string
          && (isPositiveNumber(request.resource.data.balance) || isExactTestBackupRestore(accountId));
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Giao dịch (chi tiêu, chờ xác nhận QR, chuyển nội bộ, cho mượn)
      match /transactions/{txId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId)
          && request.resource.data.merchant is string
          && isPositiveNumber(request.resource.data.amount)
          && request.resource.data.type in ['expense', 'internal', 'loan', 'income']
          && request.resource.data.status in ['confirmed', 'pending', 'cancelled', 'deleted'];
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Chi tiêu dự kiến sắp tới (trừ trước khỏi khả dụng để không ảo giác giàu)
      match /plannedExpenses/{planId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Mục tiêu tiết kiệm & Quỹ dự phòng
      match /goals/{goalId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      // Danh sách cân nhắc 24h (tránh mua bốc đồng)
      match /pausedItems/{itemId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // =========================================================================
    // 2. SHARED GROUPS (QUỸ CHUNG CẶP ĐÔI / BẠN CÙNG PHÒNG)
    // =========================================================================
    match /groups/{groupId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.memberUids || isAdmin()
      );
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.memberUids || isAdmin()
      );
      allow delete: if isSignedIn() && (
        resource.data.ownerUid == request.auth.uid || isAdmin()
      );
    }

    // =========================================================================
    // 3. SAAS LICENSE KEYS (MÃ KÍCH HOẠT BÁN TÀI KHOẢN)
    // =========================================================================
    match /licenseKeys/{code} {
      // Không cho list toàn bộ kho mã; người dùng chỉ kiểm tra được đúng mã họ nhập
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create, delete: if isAdmin();

      // Người dùng chỉ được đánh dấu đã dùng một mã chưa có người nhận
      allow update: if isAdmin() || (
        isSignedIn()
        && resource.data.active == true
        && resource.data.usedBy == null
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.active == resource.data.active
      );
    }

    // Mặc định từ chối mọi truy cập ngoài các collection đã khai báo
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
